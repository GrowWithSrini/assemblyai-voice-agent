# Create a key at https://www.assemblyai.com/dashboard/api-keys
# The same key is used for realtime STT and the LLM Gateway.
ASSEMBLYAI_API_KEY=your_key_here

# STT (realtime streaming)
STT_BASE=https://streaming.assemblyai.com
STT_TOKEN_EXPIRES_IN_SECONDS=60
STT_MAX_SESSION_DURATION_SECONDS=3600
STT_SPEECH_MODEL=universal-3-5-pro
STT_SAMPLE_RATE=16000
STT_MODE=balanced

# LLM (AssemblyAI LLM Gateway — OpenAI-compatible, same API key)
# Free/default model available to every account. Premium models
# (claude-sonnet-4-6, gpt-5.1, gemini-2.5-flash, ...) need account access enabled.
LLM_BASE=https://llm-gateway.assemblyai.com
LLM_MODEL=qwen3.5-4b-32k-fast
LLM_MAX_TOKENS=400

# JSON-Schema tool calling (get_current_time, get_weather in app/tools.py).
# Auto: off for qwen3.5-4b-32k-fast (rejects a tools payload), on for other models.
# Set explicitly to force it: LLM_ENABLE_TOOLS=true
# LLM_ENABLE_TOOLS=

# Listen port. PaaS hosts (Azure App Service / Container Apps) set PORT or
# WEBSITES_PORT automatically; only set this for a custom local port.
# PORT=8000
